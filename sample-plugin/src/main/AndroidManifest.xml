<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      A plugin declares its own permissions and Easymatic never lends it any. This one
      needs none, which is the honest shape for a sample; a plugin that scanned
      Bluetooth would declare BLUETOOTH_SCAN here and Easymatic would check it against
      *this* package, warn when it is missing, and still not be able to do it on the
      plugin's behalf.
    -->

    <application
        android:allowBackup="true"
        android:label="Easymatic Sample Tools"
        android:supportsRtl="true">

        <!--
          The whole of a plugin's manifest contribution.

          `exported="true"` because the host is a different app; the custom permission
          is what stops any *other* app binding it. That permission is declared by
          Easymatic at protectionLevel="normal" rather than "signature" — a third-party
          plugin is by definition not signed by the host, so a signature-level
          permission would quietly restrict the whole mechanism to first-party plugins.
          The real gate is the user's enable switch on the Plugins screen.
        -->
        <service
            android:name=".SamplePluginService"
            android:exported="true"
            android:permission="io.github.m1n1m1.easymatic.permission.BIND_PLUGIN">
            <intent-filter>
                <action android:name="io.github.m1n1m1.easymatic.action.PLUGIN" />
            </intent-filter>
        </service>

        <!--
          The optional second half: a screen where the user signs in to whatever this
          plugin talks to.

          Easymatic offers a button to it from the Plugins screen. It resolves this
          filter against *this package* through PackageManager and launches the result by
          component — never from anything the plugin sent over the binder, which is why
          this is a manifest convention rather than a wire field.

          `exported="true"` because the launcher is a different app. No permission on it:
          the screen holds the user's own credentials for the user's own service, and
          gating it behind BIND_PLUGIN would only stop the user reaching it themselves.
        -->
        <activity
            android:name=".SampleSettingsActivity"
            android:exported="true"
            android:label="Sample Tools">
            <intent-filter>
                <action android:name="io.github.m1n1m1.easymatic.action.PLUGIN_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          The plugin's own chooser, opened by a @PluginChoice(chooser = SCREEN) field.

          One Activity serves every such field this plugin declares; it dispatches on the
          `source` extra. Found the same way the settings screen is — resolved against this
          package through PackageManager and started by component — and it answers with one
          string, which is the whole of what crosses back.
        -->
        <activity
            android:name=".SampleChoiceActivity"
            android:exported="true"
            android:label="Choose a card">
            <intent-filter>
                <action android:name="io.github.m1n1m1.easymatic.action.PLUGIN_CHOICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
