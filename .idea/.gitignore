# Default ignored files
/shelf/
/workspace.xml

# Regenerated by Android Studio on every Gradle sync, and its module names come from the
# checkout's *folder* name rather than from `rootProject.name` — so the two disagree
# whenever the directory is not named after the project, and the file churns per machine.
# It affects nothing in the build, and it had been carrying a stale entry for a
# `facebook-plugin` module this build does not have.
/compiler.xml
