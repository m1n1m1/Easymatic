<?xml version="1.0" encoding="utf-8"?>
<!--
    Both canRequestFilterKeyEvents and the flagRequestFilterKeyEvents flag are
    required; declaring one without the other silently yields no key events at
    all.

    accessibilityEventTypes is deliberately omitted (it defaults to none) and
    canRetrieveWindowContent is false, so key events are the entire surface this
    service has. It cannot see screen content.

    isAccessibilityTool is false because this is an automation feature, not an
    assistive one. Claiming otherwise is what gets apps removed from Play.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="false"
    android:description="@string/accessibility_service_description"
    android:isAccessibilityTool="false"
    android:notificationTimeout="0"
    android:summary="@string/accessibility_service_summary" />
