<?xml version="1.0" encoding="utf-8"?>
<!--
    What the launcher shows between dropping a widget and Glance producing its
    first RemoteViews. An empty card rather than nothing, because "nothing" is a
    transparent hole in the home screen and reads as a widget that failed.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_surface" />
