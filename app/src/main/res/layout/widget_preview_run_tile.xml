<?xml version="1.0" encoding="utf-8"?>
<!--
    Picker preview for the Run tile.

    API 31+ only — `previewLayout` was added there, and below it the launcher
    falls back to the app icon. That is why the system palette is not needed
    here: this is inflated by the launcher in its own configuration, so the
    ordinary values/ + values-night/ colours resolve correctly.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_surface"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/widget_preview_chip">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_macro_sun"
            android:tint="@color/macro_accent_amber" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/widget_preview_macro"
            android:textColor="@color/widget_preview_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/widget_preview_ready"
            android:textColor="@color/widget_preview_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
