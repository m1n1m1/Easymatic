<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <!--
      Only ever used to resolve a contact a node points at, when that node runs.
      Choosing the contact needs nothing: the system picker grants read access to
      the one row it returns.
    -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!--
      Normal permission, needed by ConnectivityManager.registerNetworkCallback, which
      is how `trigger.wifi_network` learns that a network was joined or left.

      Naming that network is a separate matter and needs ACCESS_FINE_LOCATION below —
      which is declared already, for geofences. NEARBY_WIFI_DEVICES is deliberately
      NOT declared: it only substitutes for location when it carries
      usesPermissionFlags="neverForLocation", and knowing which network you are on is
      precisely a statement about where you are. Location stays the single story on
      every API level.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
      Normal permission, needed to hold a WifiManager.MulticastLock while browsing
      for smart-home hubs over mDNS. Without the lock the Wi-Fi driver filters out
      multicast frames not addressed to this device, so the browse finds nothing —
      silently, and on some devices and not others.

      It gets no `Permissions` constant, for the reason WAKE_LOCK and
      ACCESS_NETWORK_STATE do not: it is granted at install and never checked. It is
      also held only while the pairing screen is open; nothing in a running macro
      touches it, because a node is handed an address rather than asked to find one.
    -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!--
      Install-time, so always held and never checked at runtime: it gets no
      `Permissions` constant for the same reason WAKE_LOCK and ACCESS_NETWORK_STATE
      do not. What actually decides whether `trigger.nfc` can fire is the radio
      being switched on, which is PrerequisiteType.NFC.

      The uses-feature line below is not optional politeness. Declaring
      android.permission.NFC implies `<uses-feature android:name="android.hardware.nfc"
      android:required="true">`, which would make the app uninstallable from the Play
      Store on every phone without an NFC chip — for one trigger out of forty.
    -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FLASHLIGHT" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The dialog nodes (`action.dialog_*`), and the three that open another app
         (`action.launch_app`, `action.open_url`, `action.call`). The engine is a
         background service, which since Android 10 may not start an Activity at
         all; holding this is both what lets a window be drawn and the documented
         exemption from that restriction. A foreground service is *not* an
         exemption, which is why the launching nodes need this too. Granted on a
         Settings page, never through a runtime dialog — see
         PrerequisiteType.OVERLAY. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Held only while a gesture trigger is armed with "keep working when the
         screen is off" AND the screen is actually off. A foreground service does
         not keep the CPU awake, so without this the SoC suspends and non-wake-up
         sensors stop reporting. Normal permission: no runtime grant needed. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <application
        android:name=".OttomaticApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ottomatic">

        <!-- Key for the geofence editor's map, injected from local.properties at
             build time (see app/build.gradle.kts). Blank when unset: the map
             renders empty tiles but nothing crashes. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Ottomatic"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- The launcher reads the static shortcuts from the activity that
                 declares LAUNCHER, which is why this hangs here rather than on
                 the application element. The dynamic ones MacroShortcuts
                 publishes are attached to this same activity at runtime. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- What a launcher shortcut opens. Exported because the launcher is a
             different app and starts it by name; it reads two ids out of its own
             intent and does nothing else, so there is no surface to abuse.

             Invisible by construction: translucent so nothing is drawn, noHistory
             so it leaves no back stack, excludeFromRecents so it never appears in
             the recents list, and an empty taskAffinity so it does not attach
             itself to MainActivity's task and drag the app's window along with
             it. -->
        <activity
            android:name=".feature.shortcut.RunTriggerActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Where a tag tap arrives. Exported because the system dispatches the
             tag intent to it by name; it reads an id out of that intent and does
             nothing else, so there is no surface to abuse.

             An Activity rather than a receiver because Android has no background
             NFC scanning: a tag is dispatched to an activity or to nobody. Given
             that, it wears RunTriggerActivity's disguise for the same reasons —
             translucent, noHistory, excludeFromRecents, and an empty taskAffinity
             so it does not drag MainActivity's window into view behind it.

             TECH_DISCOVERED rather than TAG_DISCOVERED: the last of the three is
             only consulted when nothing else handled the tag, so a trigger would
             lose every tag any other app had ever claimed. See nfc_tech_filter.xml
             for which techs are listed, and why payment cards are not among them. -->
        <activity
            android:name=".data.trigger.NfcTagActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.nfc.action.TECH_DISCOVERED" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.action.TECH_DISCOVERED"
                android:resource="@xml/nfc_tech_filter" />
        </activity>

        <!-- ===== Home-screen widgets =====

             Each is a Glance widget: a receiver the launcher talks to, plus (for
             the two that have something to choose) a configuration activity it
             opens on drop.

             The receivers are NOT exported. A widget provider only ever receives
             APPWIDGET_* broadcasts from the system, which is allowed to deliver
             them to a non-exported receiver in the same way it delivers a boot
             broadcast; nothing else has any business poking one.

             The configuration activities ARE exported, and have to be: the
             launcher is a different app and starts them by component name. They
             take no data and act only on the widget id the launcher supplies. -->

        <receiver
            android:name=".feature.widget.RunTileReceiver"
            android:exported="false"
            android:label="@string/widget_run_tile_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_run_tile" />
        </receiver>

        <receiver
            android:name=".feature.widget.PanelReceiver"
            android:exported="false"
            android:label="@string/widget_panel_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_panel" />
        </receiver>

        <!-- The success callback of a "pin this Run tile" request from the workflow
             list. Not exported, and correctly so: it is only ever reached through a
             PendingIntent this app created, which the system sends with this app's
             identity however far it travelled through the launcher on the way. -->
        <receiver
            android:name=".feature.widget.RunTilePinnedReceiver"
            android:exported="false" />

        <activity
            android:name=".feature.widget.RunTileConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.Ottomatic">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity
            android:name=".feature.widget.PanelConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.Ottomatic">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".data.trigger.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".data.trigger.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".data.trigger.ChargingReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".data.trigger.GeofenceReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.ottomatic.GEOFENCE_TRANSITION" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".data.trigger.AlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.ottomatic.SCHEDULE_ALARM" />
            </intent-filter>
        </receiver>

        <!-- The alarm behind `action.wait_until` and `action.delay`. Separate from
             AlarmReceiver above because a wait resumes one suspended coroutine by
             token, where a schedule alarm publishes an event onto the trigger bus
             for whichever node id it names. -->
        <receiver
            android:name=".data.wait.WaitAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.ottomatic.WAIT_ALARM" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".data.trigger.SystemStateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.net.wifi.WIFI_STATE_CHANGED" />
                <action android:name="android.bluetooth.adapter.action.STATE_CHANGED" />
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
                <action android:name="android.intent.action.AIRPLANE_MODE" />
                <action android:name="android.intent.action.HEADSET_PLUG" />
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
                <action android:name="android.hardware.usb.action.USB_DEVICE_DETACHED" />
                <action android:name="android.intent.action.DOCK_EVENT" />
                <action android:name="android.media.RINGER_MODE_CHANGED" />
                <action android:name="android.os.action.POWER_SAVE_MODE_CHANGED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.SHUTDOWN" />
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".data.trigger.PackageReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <action android:name="android.intent.action.PACKAGE_REMOVED" />
                <action android:name="android.intent.action.PACKAGE_REPLACED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".data.trigger.MediaReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
                <action android:name="android.intent.action.MEDIA_MOUNTED" />
                <action android:name="android.intent.action.MEDIA_UNMOUNTED" />
                <action android:name="android.intent.action.MEDIA_EJECT" />
                <data android:scheme="file" />
            </intent-filter>
        </receiver>

        <service
            android:name=".data.trigger.NotificationListener"
            android:exported="false"
            android:label="Ottomatic Notification Listener"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- The only way an app can observe key events it did not receive
             itself. Never consumes them: see OttomaticAccessibilityService. -->
        <service
            android:name=".data.accessibility.OttomaticAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <service
            android:name=".engine.service.MacroEngineService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs user-armed automation macros in the background in response to system triggers (SMS, schedule, geofence, etc.)." />
        </service>
    </application>

</manifest>
