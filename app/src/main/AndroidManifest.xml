<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <!--
      Only ever used to resolve a contact a node points at, when that node runs.
      Choosing the contact needs nothing: the system picker grants read access to
      the one row it returns.
    -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!--
      The calendar nodes, and the calendar chooser in their config forms.

      Unlike READ_CONTACTS above there is no transient grant to lean on: the platform
      offers no calendar picker, so Ottomatic lists the calendars itself and needs the
      read grant before a form can show anything at all. WRITE_CALENDAR is declared
      only by the two nodes that create or change an event; reading and writing are
      separate grants to the platform, and the difference between "reads my meetings"
      and "can delete my meetings" is a real one to the person granting them.

      No receiver goes with these. CalendarContract.ACTION_EVENT_REMINDER exists and is
      genuinely broadcast by the provider, but it is an *implicit* broadcast and is not on
      Android 8's exemption list, so a manifest receiver for it is never delivered — the
      same fact ScreenBroadcastBridge's KDoc states about ACTION_TIME_TICK. The reminder
      mode of `trigger.calendar_event` therefore plans its own exact alarm from the
      event's own reminder row, which additionally works when the provider's alert path is
      one an OEM calendar has replaced.
    -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!--
      Normal permission, needed by ConnectivityManager.registerNetworkCallback, which
      is how `trigger.wifi_network` learns that a network was joined or left.

      Naming that network is a separate matter and needs ACCESS_FINE_LOCATION below —
      which is declared already, for geofences. NEARBY_WIFI_DEVICES is deliberately
      NOT declared: it only substitutes for location when it carries
      usesPermissionFlags="neverForLocation", and knowing which network you are on is
      precisely a statement about where you are. Location stays the single story on
      every API level.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
      Normal permission, needed to hold a WifiManager.MulticastLock while browsing
      for smart-home hubs over mDNS. Without the lock the Wi-Fi driver filters out
      multicast frames not addressed to this device, so the browse finds nothing —
      silently, and on some devices and not others.

      It gets no `Permissions` constant, for the reason WAKE_LOCK and
      ACCESS_NETWORK_STATE do not: it is granted at install and never checked. It is
      also held only while the pairing screen is open; nothing in a running macro
      touches it, because a node is handed an address rather than asked to find one.
    -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!--
      Install-time, so always held and never checked at runtime: it gets no
      `Permissions` constant for the same reason WAKE_LOCK and ACCESS_NETWORK_STATE
      do not. What actually decides whether `trigger.nfc` can fire is the radio
      being switched on, which is PrerequisiteType.NFC.

      The uses-feature line below is not optional politeness. Declaring
      android.permission.NFC implies `<uses-feature android:name="android.hardware.nfc"
      android:required="true">`, which would make the app uninstallable from the Play
      Store on every phone without an NFC chip — for one trigger out of forty.
    -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />

    <!--
      The image nodes: trigger.image_saved, value.latest_image and the six
      action.image_* nodes.

      Two names for one capability. The split at API 33 is a *rename* rather than a
      new grant, so both are declared and `Permission.onApi` decides which one is
      checked and requested — see the KDoc there, and note that getting this wrong
      means a grant requested under one name and checked under the other, which can
      never be satisfied. READ_EXTERNAL_STORAGE is capped at 32 because from 33 the
      platform ignores it, and an uncapped declaration is a Play warning about a
      permission the app cannot use.

      READ_MEDIA_VISUAL_USER_SELECTED (API 34) is deliberately NOT declared. "Select
      photos" hands over a fixed set chosen once, which is no use at all to a trigger
      whose whole job is noticing a photo that did not exist yet — so partial access
      reads as denied here and the Permissions screen says why, rather than the app
      half-working in a way nobody could diagnose.
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!--
      Changing or deleting a picture another app saved, at or below API 28 and
      nowhere else. From 29 there is no permission for this at all: the platform asks
      the user per operation through an IntentSender, which is why
      `existsOnThisApi` reports it *granted* above 28 rather than denied. See
      MediaConsents for the whole ladder.
    -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!--
      The GPS tags inside a picture. From API 29 MediaStore strips them out of the
      bytes it hands over unless this is held AND the URI has been through
      MediaStore.setRequireOriginal — both, not either. Declared by
      action.image_info alone.
    -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <!--
      Changing photos without a confirmation dialog each time (API 31+). A special
      permission granted on its own Settings page, never requested by a node and
      never required by one: every image node works without it by asking. It is
      offered on the Permissions screen as "stop asking me every time".
    -->
    <uses-permission android:name="android.permission.MANAGE_MEDIA" />

    <!--
      Plugin discovery.

      QUERY_ALL_PACKAGES already makes this work, so the <queries> block below is
      belt-and-braces on purpose: that permission is Play-policy-restricted and a
      plausible future removal, and the day it goes, discovery has to keep working.
      A narrow declaration naming exactly the one action we look for is also a better
      posture than the blanket grant, and is what the app should be left with.
    -->
    <queries>
        <intent>
            <action android:name="com.example.ottomatic.action.PLUGIN" />
        </intent>
        <!--
          A plugin's own settings screen, where it signs in to whatever it talks to.
          Optional, and resolved separately from the service: a plugin may have one
          without exporting an Activity under it, and without this the query returns
          nothing on API 30+ and the button never appears.
        -->
        <intent>
            <action android:name="com.example.ottomatic.action.PLUGIN_SETTINGS" />
        </intent>
        <!--
          A plugin's own chooser screen, opened by a @PluginChoice(chooser = SCREEN) field.
          Also optional, also resolved separately: a plugin may declare such a field and
          ship no Activity for it, which is a mistake the host reports in the chooser
          rather than one it can prevent.
        -->
        <intent>
            <action android:name="com.example.ottomatic.action.PLUGIN_CHOICE" />
        </intent>
    </queries>

    <!--
      What a plugin app puts on its exported service, so that no *other* app can bind
      it and drive somebody's plugin.

      protectionLevel="normal" rather than "signature", and this is the decision worth
      recording: a third-party plugin is by definition not signed by Ottomatic's key,
      so a signature-level permission would silently restrict the entire mechanism to
      plugins we published ourselves — the opposite of the point. "normal" is granted
      at install without prompting, which is right for something whose only power is
      "may talk to a plugin".

      The real trust gate is elsewhere and is explicit: a discovered plugin contributes
      no nodes at all until the user enables it on the Plugins screen.
    -->
    <permission
        android:name="com.example.ottomatic.permission.BIND_PLUGIN"
        android:label="@string/permission_bind_plugin_label"
        android:description="@string/permission_bind_plugin_description"
        android:protectionLevel="normal" />

    <uses-permission android:name="com.example.ottomatic.permission.BIND_PLUGIN" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!--
      Claimed only for the seconds `action.camera_photo` has the camera open. The engine is
      a `specialUse` foreground service, and from Android 11 a service's access to the
      camera follows its foreground service *type* rather than the app's grant — so the type
      is promoted to `specialUse|camera` for the duration of one capture and dropped again.
      From API 34, naming that type additionally needs this declaration AND the CAMERA
      runtime grant to be held at the moment `startForeground` runs, or it throws. See
      `ServiceForeground` for why the claim cannot simply be permanent.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!--
      The same borrowing, for the three `action.record_*` nodes. The microphone follows the
      foreground service type from API 30 rather than API 11's camera rule, and the failure
      without it is the quieter of the two: the recording succeeds and contains silence, with
      nothing anywhere reporting a problem.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- The torch (`action.flashlight`), and `action.camera_photo`, which opens the camera
         itself through camera2 rather than handing the job to a camera app. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FLASHLIGHT" />
    <!-- The three `action.record_*` nodes. Nothing else in the app opens the microphone. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The dialog nodes (`action.dialog_*`), and the three that open another app
         (`action.launch_app`, `action.open_url`, `action.call`). The engine is a
         background service, which since Android 10 may not start an Activity at
         all; holding this is both what lets a window be drawn and the documented
         exemption from that restriction. A foreground service is *not* an
         exemption, which is why the launching nodes need this too. Granted on a
         Settings page, never through a runtime dialog — see
         PrerequisiteType.OVERLAY. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Held only while a gesture trigger is armed with "keep working when the
         screen is off" AND the screen is actually off. A foreground service does
         not keep the CPU awake, so without this the SoC suspends and non-wake-up
         sensors stop reporting. Normal permission: no runtime grant needed. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!--
      android:networkSecurityConfig permits cleartext HTTP, so a self-hosted AI
      connection can reach a model server on the user's own network. The config file
      itself explains why that has to be app-wide and what it costs.
    -->
    <application
        android:name=".OttomaticApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ottomatic">

        <!-- Key for the geofence editor's map, injected from local.properties at
             build time (see app/build.gradle.kts). Blank when unset: the map
             renders empty tiles but nothing crashes. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Ottomatic"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- The launcher reads the static shortcuts from the activity that
                 declares LAUNCHER, which is why this hangs here rather than on
                 the application element. The dynamic ones MacroShortcuts
                 publishes are attached to this same activity at runtime. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- What a launcher shortcut opens.

             NOT exported, and the change from exported="true" is the point. The
             old comment argued there was "no surface to abuse" because it only
             reads two ids out of its intent — but those two ids are *which macro
             to run*, so any app on the device could start any `trigger.manual`
             node, with no opt-in and no record. That was an unintended process
             API; the deliberate one is ApiTriggerProvider and ApiTriggerReceiver
             below, and this is how it stops being the back door beside them.

             Shortcuts keep working because the system starts a shortcut's intent
             *as the publisher* — LauncherApps.startShortcut hands it to
             ActivityTaskManager under our own uid — so being exported bought
             nothing that the shortcut path needed. MacroShortcuts is the only
             producer of this intent.

             Invisible by construction: translucent so nothing is drawn, noHistory
             so it leaves no back stack, excludeFromRecents so it never appears in
             the recents list, and an empty taskAffinity so it does not attach
             itself to MainActivity's task and drag the app's window along with
             it. -->
        <activity
            android:name=".feature.shortcut.RunTriggerActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Where Android's "let this app change this photo?" dialog is shown from.
             startIntentSenderForResult is an Activity method and the engine is a
             service, so an image write that needs consent has nowhere else to ask;
             see MediaConsents for the whole ladder.

             It wears RunTriggerActivity's disguise with **one deliberate exception**:
             noHistory is absent. That flag finishes an activity as soon as it stops
             being visible, which here is exactly when the system dialog appears — so
             the result would never arrive and every consented write would report a
             refusal. The other three flags are for RunTriggerActivity's reasons. -->
        <activity
            android:name=".feature.images.MediaConsentActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- The process API's app-facing door.

             A ContentProvider rather than a bound service with an AIDL because
             call() gives a caller a synchronous result and gives us a
             system-verified getCallingPackage(), which is everything the AIDL
             would have bought, for one line at the call site and no dependency on
             us at all.

             There is deliberately NO android:permission here, and neither
             readPermission nor writePermission would help if there were:
             ContentProvider.Transport.call performs no permission enforcement, so
             a manifest guard on this is decorative. The gate is therefore in
             code, and it is the user's own approval — the same trust model the
             Plugins screen is for plugins, with the signing certificate pinned at
             approval time and re-checked on every call.

             grantUriPermissions="false" because there is no table, no Uri and
             nothing to grant: the whole API is call(). -->
        <provider
            android:name=".engine.service.ApiTriggerProvider"
            android:authorities="com.example.ottomatic.triggers"
            android:exported="true"
            android:grantUriPermissions="false" />

        <!-- The process API's door for everything that is not an Android app: a
             shell script, Tasker, Automate, an `adb shell am broadcast`. None of
             those can call a ContentProvider, which is the only reason this
             exists beside the provider rather than instead of it.

             A key is always required here, because a broadcast carries no sender
             identity at all — there is nothing to recognise, only something to
             authenticate. See ApiTriggerReceiver's KDoc. -->
        <receiver
            android:name=".engine.service.ApiTriggerReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.example.ottomatic.action.RUN_MACRO" />
            </intent-filter>
        </receiver>

        <!-- Where an app asks to be allowed to call. Exported because the whole
             point is that another app starts it — but it refuses any launch where
             getCallingPackage() is null, i.e. anything but startActivityForResult,
             which is the only form the system vouches for the caller's identity
             in. That check is what stops an app raising this dialog about
             somebody else. -->
        <activity
            android:name=".feature.api.ApiConsentActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:taskAffinity="" />

        <!-- Where a tag tap arrives. Exported because the system dispatches the
             tag intent to it by name; it reads an id out of that intent and does
             nothing else, so there is no surface to abuse.

             An Activity rather than a receiver because Android has no background
             NFC scanning: a tag is dispatched to an activity or to nobody. Given
             that, it wears RunTriggerActivity's disguise for the same reasons —
             translucent, noHistory, excludeFromRecents, and an empty taskAffinity
             so it does not drag MainActivity's window into view behind it.

             TECH_DISCOVERED rather than TAG_DISCOVERED: the last of the three is
             only consulted when nothing else handled the tag, so a trigger would
             lose every tag any other app had ever claimed. See nfc_tech_filter.xml
             for which techs are listed, and why payment cards are not among them. -->
        <activity
            android:name=".data.trigger.NfcTagActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.nfc.action.TECH_DISCOVERED" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.action.TECH_DISCOVERED"
                android:resource="@xml/nfc_tech_filter" />
        </activity>

        <!-- Where the browser lands at the end of a Home Assistant sign-in.

             Exported because a browser has to be able to reach it, and that is
             safe here for the reason it would not be elsewhere: it validates
             nothing and grants nothing. It hands a code and a nonce to a
             process-wide flow and finishes; the nonce is compared where it was
             generated, which is the check that actually matters. A custom URI
             scheme is not exclusive on Android and any app may fire an intent at
             this one, so what arrives is untrusted by construction.

             Its own activity rather than an intent-filter on MainActivity, which
             is the shorter-looking option and is wrong: MainActivity is the
             launcher activity holding the Compose back stack, and a singleTask
             relaunch to deliver a redirect would drop the user somewhere other
             than where they were, mid-setup.

             It wears RunTriggerActivity's disguise for its reasons — translucent,
             noHistory, excludeFromRecents, and an empty taskAffinity so it does
             not drag MainActivity's window into view behind it. -->
        <activity
            android:name=".data.homeassistant.HaAuthActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="ha-auth"
                    android:scheme="ottomatic" />
            </intent-filter>
        </activity>

        <!-- ===== Home-screen widgets =====

             Each is a Glance widget: a receiver the launcher talks to, plus (for
             the two that have something to choose) a configuration activity it
             opens on drop.

             The receivers are NOT exported. A widget provider only ever receives
             APPWIDGET_* broadcasts from the system, which is allowed to deliver
             them to a non-exported receiver in the same way it delivers a boot
             broadcast; nothing else has any business poking one.

             The configuration activities ARE exported, and have to be: the
             launcher is a different app and starts them by component name. They
             take no data and act only on the widget id the launcher supplies. -->

        <receiver
            android:name=".feature.widget.RunTileReceiver"
            android:exported="false"
            android:label="@string/widget_run_tile_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_run_tile" />
        </receiver>

        <receiver
            android:name=".feature.widget.PanelReceiver"
            android:exported="false"
            android:label="@string/widget_panel_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_panel" />
        </receiver>

        <!-- The success callback of a "pin this Run tile" request from the workflow
             list. Not exported, and correctly so: it is only ever reached through a
             PendingIntent this app created, which the system sends with this app's
             identity however far it travelled through the launcher on the way. -->
        <receiver
            android:name=".feature.widget.RunTilePinnedReceiver"
            android:exported="false" />

        <activity
            android:name=".feature.widget.RunTileConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.Ottomatic">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity
            android:name=".feature.widget.PanelConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.Ottomatic">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".data.trigger.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>

        <!-- The device administrator behind `trigger.login_failed`. Only
             DEVICE_ADMIN_ENABLED belongs in the filter: every other admin
             broadcast, ACTION_PASSWORD_FAILED included, is sent explicitly to
             this component and is therefore exempt from the background
             broadcast restrictions. -->
        <receiver
            android:name=".data.trigger.LoginAdminReceiver"
            android:description="@string/device_admin_description"
            android:exported="true"
            android:label="@string/device_admin_label"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />

            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".data.trigger.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".data.trigger.ChargingReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".data.trigger.GeofenceReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.ottomatic.GEOFENCE_TRANSITION" />
                <action android:name="com.example.ottomatic.GEOFENCE_AWAY" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".data.trigger.AlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.ottomatic.SCHEDULE_ALARM" />
            </intent-filter>
        </receiver>

        <!-- The alarm behind `action.wait_until` and `action.delay`. Separate from
             AlarmReceiver above because a wait resumes one suspended coroutine by
             token, where a schedule alarm publishes an event onto the trigger bus
             for whichever node id it names. -->
        <receiver
            android:name=".data.wait.WaitAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.ottomatic.WAIT_ALARM" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".data.trigger.SystemStateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.net.wifi.WIFI_STATE_CHANGED" />
                <action android:name="android.bluetooth.adapter.action.STATE_CHANGED" />
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
                <action android:name="android.intent.action.AIRPLANE_MODE" />
                <action android:name="android.intent.action.HEADSET_PLUG" />
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
                <action android:name="android.hardware.usb.action.USB_DEVICE_DETACHED" />
                <action android:name="android.intent.action.DOCK_EVENT" />
                <action android:name="android.media.RINGER_MODE_CHANGED" />
                <action android:name="android.os.action.POWER_SAVE_MODE_CHANGED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.SHUTDOWN" />
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".data.trigger.PackageReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <action android:name="android.intent.action.PACKAGE_REMOVED" />
                <action android:name="android.intent.action.PACKAGE_REPLACED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".data.trigger.MediaReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
                <action android:name="android.intent.action.MEDIA_MOUNTED" />
                <action android:name="android.intent.action.MEDIA_UNMOUNTED" />
                <action android:name="android.intent.action.MEDIA_EJECT" />
                <data android:scheme="file" />
            </intent-filter>
        </receiver>

        <!-- Where a tap, a button press or a swipe on one of *our own* notifications
             lands, so `action.notify` can carry on where it left off. Not exported,
             and correctly so on RunTilePinnedReceiver's reasoning: it is only ever
             reached through a PendingIntent this app created, which the system sends
             with this app's identity however far it travelled through the shade.

             Nothing to do with the listener below it, which reads *other* apps'
             notifications and needs a system-granted binding to do so. -->
        <receiver
            android:name=".data.notification.NotificationResponseReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.ottomatic.action.NOTIFICATION_RESPONSE" />
            </intent-filter>
        </receiver>

        <service
            android:name=".data.trigger.NotificationListener"
            android:exported="false"
            android:label="Ottomatic Notification Listener"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- The only way an app can observe key events it did not receive
             itself. Never consumes them: see OttomaticAccessibilityService. -->
        <service
            android:name=".data.accessibility.OttomaticAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <service
            android:name=".engine.service.MacroEngineService"
            android:exported="false"
            android:foregroundServiceType="specialUse|camera|microphone">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs user-armed automation macros in the background in response to system triggers (SMS, schedule, geofence, etc.)." />
        </service>
    </application>

</manifest>
